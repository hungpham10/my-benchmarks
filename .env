# Benchmark scale: 10000 instances x 2 metrics = 20k series; 45 min @ 15s
# = 180 samples each = 3.6M samples.
#
# The window is 45 minutes because that is close to the hard ceiling. Prometheus
# accepts remote-write samples at most 10 minutes ahead of wall clock
# (maxAheadTime, storage/remote/write_handler.go:53) and refuses anything older
# than MaxTime - chunkRange/2, i.e. one hour at the default 2h block range
# (head_append.go:212). A fresh TSDB therefore cannot be backfilled with a day
# of history at all. Volume is bought with cardinality instead.
JOBS=20
INSTANCES_PER_JOB=500
INTERVAL_SECONDS=15
WINDOW_MINUTES=45
AHEAD_MINUTES=8
SEED=20240101

# Derived: do not edit by hand.
TOTAL_SERIES=20000
SAMPLES_PER_SERIES=180
TOTAL_SAMPLES=3600000

# Ingest batching. Names here are the ones generate.py actually reads.
SCRAPES_PER_REQUEST=240
SERIES_CHUNK=1000

# Query benchmark. Iterations must be large enough for a percentile to mean
# anything: at 30 samples a P95 is indistinguishable from the maximum.
QUERY_ITERATIONS=300
QUERY_WARMUP=20
QUERY_TIMEOUT_S=120

# Resource envelope, applied identically to Prometheus and PostgreSQL.
# Sized against `colima start --cpu 4 --memory 10 --disk 80`: two targets at
# 1.5 CPU / 4 GB each leaves one core and ~2 GB for the runner and the OS.
# Equal budgets are the whole point - change one, change both.
TARGET_CPUS=1.5
TARGET_MEMORY=4G

# Ports. Prometheus only; the query suite runs inside the compose network.
PROMETHEUS_PORT=9090
POSTGRES_PORT=5432
