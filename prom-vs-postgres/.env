# Benchmark scale: 10000 instances x 2 metrics = 20k series; 45 min @ 15s
# = 180 samples each = 3.6M samples.
#
# The window is 45 minutes because that is close to the hard ceiling. Prometheus
# accepts remote-write samples at most 10 minutes ahead of wall clock
# (maxAheadTime, storage/remote/write_handler.go:53) and refuses anything older
# than MaxTime - chunkRange/2, i.e. one hour at the default 2h block range
# (head_append.go:212). A fresh TSDB therefore cannot be backfilled with a day
# of history at all. Volume is bought with cardinality instead.
JOBS=20
INSTANCES_PER_JOB=500
INTERVAL_SECONDS=15
WINDOW_MINUTES=45
AHEAD_MINUTES=8
SEED=20240101

# Derived: do not edit by hand.
TOTAL_SERIES=20000
SAMPLES_PER_SERIES=180
TOTAL_SAMPLES=3600000

# Ingest batching. Names here are the ones generate.py actually reads.
SCRAPES_PER_REQUEST=240
SERIES_CHUNK=1000

# Query benchmark. Iterations must be large enough for a percentile to mean
# anything: at 30 samples a P95 is indistinguishable from the maximum.
QUERY_ITERATIONS=300
QUERY_WARMUP=20
QUERY_TIMEOUT_S=120

# k6 scenario matrix. VUS levels are comma-separated; each (query, backend, vus)
# cell runs as its own k6 invocation for K6_DURATION. VUS > 1 is what measures
# queueing under concurrency -- the serial python suite cannot.
K6_VUS=1,10
K6_DURATION=180s

# Resource envelope, applied identically to Prometheus and PostgreSQL.
#
# Sized against a 4-core host: 1 core each for the two systems under test, 1
# for the k6 load driver, and the remaining 1 shared by the OS and the
# monitoring stack. Equal budgets for the two targets are the whole point -
# change one, change both.
#
# k6 gets its own core rather than sharing the leftover. It is the thing
# generating the load, so if it competes for a core with the system being
# measured, the measurement includes k6's own scheduling. At 1.5 each the two
# targets claimed 3 cores and left one to be split between k6, Alloy, Grafana
# and the kernel, which is the arrangement under which throughput numbers stop
# describing either database.
#
# CHANGING THIS INVALIDATES THE RECORDED RUN. results/ was measured with
# TARGET_CPUS=1.5. Disk per sample does not depend on the CPU cap, but every
# latency and throughput figure does. Re-run before quoting either.
TARGET_CPUS=1
TARGET_MEMORY=4G

# The load driver. One core, and memory bounded so a runaway scenario cannot
# take the host down with it.
K6_CPUS=1
K6_MEMORY=1G

# Ports. Prometheus only; the query suite runs inside the compose network.
PROMETHEUS_PORT=9090
POSTGRES_PORT=5432
