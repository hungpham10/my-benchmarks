# Grafana Cloud credentials for the remote_write push. Copy this file to
# .env.monitoring, fill it in, and never commit the copy: it is gitignored,
# and a Grafana access policy token can push metrics into your stack from
# anywhere on the internet.
#
#   cp monitoring/.env.monitoring.example monitoring/.env.monitoring
#   make monitor-cloud
#
# Grafana Cloud -> your stack -> "Prometheus" -> "Remote write" holds all three
# values. The URL ends in /api/prom/push. The ID is the number before the colon
# in the basic-auth username Grafana shows you.

GRAFANA_CLOUD_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_ID=123456
GRAFANA_CLOUD_TOKEN=glc_your-token-here

# Optional: where k6 pushes its own metrics. Leave unset to derive it from the
# three values above (same endpoint, basic-auth embedded in the URL).
#K6_CLOUD_RW_URL=https://123456:glc_your-token-here@prometheus-prod-XX.grafana.net/api/prom/push
