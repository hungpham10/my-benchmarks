{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud)",
      "description": "The Cloud stack that receives this benchmark's metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "title": "Prometheus vs PostgreSQL \u2014 comparison",
  "description": "Throughput, CPU, memory and disk for the two systems, measured while both are under load.",
  "tags": [
    "benchmark",
    "prometheus",
    "postgresql"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Prometheus vs PostgreSQL \u2014 comparison",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "Envelope in force",
      "description": "Both systems are capped identically (TARGET_CPUS / TARGET_MEMORY in compose), so a gap here is a difference in the storage format rather than in how much machine each one was given.",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "count(bench_cpu_pct{system=\"prometheus\"})",
          "legendFormat": "prometheus series",
          "refId": "A"
        },
        {
          "expr": "count(bench_cpu_pct{system=\"postgres\"})",
          "legendFormat": "postgres series",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "title": "Throughput \u2014 both systems under the same load",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "Queries per second, both systems",
      "description": "One k6 run, two scenarios, same VU count on both arms, so the two lines are measured over the same wall clock. A TPS number without the load that produced it is meaningless; the VU panel below is the other half of that pair.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(k6_prom_requests_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "sum(rate(k6_pg_requests_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "Virtual users driving the run",
      "description": "k6 stamps run_id onto the Trend but not onto its own built-in metrics, so this panel has no run filter \u2014 filtering k6_vus by run_id matches nothing.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "VUs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "Latency under that load (p99)",
      "description": "From the same concurrent run. A flat latency line at falling throughput is saturation, not a fast system.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "k6_prom_query_duration_ms_p99{run_id=~\"$run_id\"}",
          "legendFormat": "Prometheus p99",
          "refId": "A"
        },
        {
          "expr": "k6_pg_query_duration_ms_p99{run_id=~\"$run_id\"}",
          "legendFormat": "PostgreSQL p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "Failed queries",
      "description": "Counted rather than logged. Under concurrency a query can fail and still contribute a latency figure, so a run of errors looks exactly like a fast system on the throughput panel above.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(k6_prom_failed_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "Prometheus failures/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(k6_pg_failed_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "PostgreSQL failures/s",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": [],
      "title": "Resources \u2014 the cost of serving that load",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "CPU",
      "description": "docker stats, sampled every 2s by the harness. Not cAdvisor: under Colima its per-container CPU is documented as untrustworthy, and this is the same source as the headline figures in results/report.md.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_cpu_pct{system=\"prometheus\"}",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "bench_cpu_pct{system=\"postgres\"}",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "Memory",
      "description": "Working set, same source as CPU above.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_mem_bytes{system=\"prometheus\"}",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "bench_mem_bytes{system=\"postgres\"}",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "title": "On disk",
      "description": "du of each system's own data directory, sampled through the run. This is the number the bytes-per-sample figure is computed from. Not cAdvisor's container_fs_usage_bytes: under Colima it carries no container label and reports the host filesystem for every series, so a panel over it draws one 25GB line for both systems and looks entirely plausible.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_disk_bytes{system=\"prometheus\"}",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "bench_disk_bytes{system=\"postgres\"}",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up, run_id)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 2
      }
    ]
  }
}
