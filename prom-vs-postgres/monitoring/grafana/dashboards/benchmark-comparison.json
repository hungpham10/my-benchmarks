{
  "__inputs": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "title": "Prometheus vs PostgreSQL \u2014 comparison",
  "description": "Throughput, CPU, memory and disk for the two systems, measured while both are under load.",
  "tags": [
    "benchmark",
    "prometheus",
    "postgresql"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Prometheus vs PostgreSQL \u2014 comparison",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Queries executed, per server (Prometheus)",
      "description": "prometheus_http_requests_total filtered to the read API. Filtered by handler rather than summed, because the same endpoint also serves remote-write and health checks, which would otherwise appear as benchmark load. This is the count the Prometheus under test reports about itself, not what k6 thinks it sent.",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(prometheus_http_requests_total{job=\"prometheus-under-test\",handler=~\"/api/v1/(query|query_range)\"{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "queries/s",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Statements executed, per server (PostgreSQL)",
      "description": "pg_stat_statements_calls_total, summed over every queryid. Per statement counts live in the same metric, split by queryid, if you want to see individual shapes. Counts everything the server ran, so during the ingest phase it includes the COPY traffic and is not a comparison of query throughput.",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_statements_calls_total{job=\"postgres-under-test\",datname=\"bench\",run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "statements/s",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "title": "Throughput \u2014 both systems under the same load",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Queries per second, both systems",
      "description": "One k6 run, two scenarios, same VU count on both arms, so the two lines are measured over the same wall clock. A TPS number without the load that produced it is meaningless; the VU panel below is the other half of that pair.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(k6_prom_requests_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "sum(rate(k6_pg_requests_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Virtual users driving the run",
      "description": "k6 stamps run_id onto the Trend but not onto its own built-in metrics, so this panel has no run filter \u2014 filtering k6_vus by run_id matches nothing.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "VUs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Latency under that load (p99)",
      "description": "From the same concurrent run. A flat latency line at falling throughput is saturation, not a fast system.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "k6_prom_query_duration_ms_p99{run_id=~\"$run_id\"}",
          "legendFormat": "Prometheus p99",
          "refId": "A"
        },
        {
          "expr": "k6_pg_query_duration_ms_p99{run_id=~\"$run_id\"}",
          "legendFormat": "PostgreSQL p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Failed queries",
      "description": "Counted rather than logged. Under concurrency a query can fail and still contribute a latency figure, so a run of errors looks exactly like a fast system on the throughput panel above.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(k6_prom_failed_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "Prometheus failures/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(k6_pg_failed_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "PostgreSQL failures/s",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": [],
      "title": "Resources \u2014 the cost of serving that load",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "CPU",
      "description": "docker stats, sampled every 2s by the harness. Not cAdvisor: under Colima its per-container CPU is documented as untrustworthy, and this is the same source as the headline figures in results/report.md.\n\nBoth systems are capped identically (TARGET_CPUS / TARGET_MEMORY in compose), so a gap here is a difference in the storage format rather than in how much machine each one was given.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_cpu_pct{system=\"prometheus\"}",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "bench_cpu_pct{system=\"postgres\"}",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "Memory",
      "description": "Working set, same source as CPU above.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_mem_bytes{system=\"prometheus\"}",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "bench_mem_bytes{system=\"postgres\"}",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "On disk, stored data only (WAL excluded)",
      "description": "This is the figure the bytes-per-sample headline in results/report.md is computed from, so the panel and the report cannot disagree. WAL is excluded on both sides: it is transient replay state, not data that is being kept. Comparing Prometheus post-WAL against PostgreSQL including-WAL reads 49x on the recorded run where the report says 59.9x. Not cAdvisor's container_fs_usage_bytes: under Colima it carries no container label and reports the host filesystem for every series, so a panel over it draws one 25GB line for both systems.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_disk_stored_bytes{system=\"prometheus\"}",
          "legendFormat": "Prometheus",
          "refId": "A"
        },
        {
          "expr": "bench_disk_stored_bytes{system=\"postgres\"}",
          "legendFormat": "PostgreSQL",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bench-monitoring"
      },
      "title": "On disk, including WAL",
      "description": "The whole data directory, so the difference from the panel on the left is the write-ahead log. PostgreSQL's is several times the size of its stored data, which is worth seeing next to it rather than folded into a single number.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "bench_disk_bytes{system=\"prometheus\"}",
          "legendFormat": "Prometheus (incl. WAL)",
          "refId": "A"
        },
        {
          "expr": "bench_disk_bytes{system=\"postgres\"}",
          "legendFormat": "PostgreSQL (incl. WAL)",
          "refId": "B"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bench-monitoring"
        },
        "query": "label_values(up, run_id)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 2
      }
    ]
  }
}
