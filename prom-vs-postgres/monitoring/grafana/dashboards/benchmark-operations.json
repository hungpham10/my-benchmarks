{
 "__inputs": [],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "editable": true,
 "graphTooltip": 1,
 "title": "Benchmark operations",
 "description": "Operational cost of a benchmark run. Deliberately reads the monitoring Prometheus, not the one under test.",
 "tags": [
  "benchmark"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "version": 1,
 "panels": [
  {
   "type": "row",
   "title": "Machine \u2014 the cost of the whole benchmark",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Host CPU (all cores)",
   "description": "Summed across cores as a percentage of one CPU each. 400% would mean every core saturated.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!~\"idle|iowait|steal\"}[1m])) * 100",
     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Host memory used",
   "description": "The envelope gives each target 4 GB. Watch this before trusting a memory number.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
     "legendFormat": "used",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Filesystem usage",
   "description": "The Prometheus volume here is the disk number from results/footprint.json, sampled over time.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})",
     "legendFormat": "{{mountpoint}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Systems under test \u2014 the same metric the benchmark measures",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Container CPU",
   "description": "Per container, from cAdvisor. This is the live version of results/resource_*.json.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{container!=\"\"}[1m])) * 100",
     "legendFormat": "{{container}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Container memory (working set)",
   "description": "The headline resource claim is 293 MiB against 1.21 GiB. This panel shows whether the run actually behaved that way.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "container_memory_working_set_bytes{container!=\"\"}",
     "legendFormat": "{{container}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Prometheus under test",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 26
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Head series",
   "description": "20,000 series expected. A curve that rises and falls across a run is compaction working.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "prometheus_tsdb_head_series",
     "legendFormat": "series",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Samples appended",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "rate(prometheus_tsdb_samples_appended_total[1m])",
     "legendFormat": "samples/s",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "WAL fsync duration",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "prometheus_tsdb_wal_fsync_duration_seconds",
     "legendFormat": "quantiles",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "PostgreSQL under test",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 35
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Database size",
   "description": "Compare the sum of these against the Prometheus filesystem panel above. That comparison is the 59.9x.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 36
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "pg_database_size_bytes",
     "legendFormat": "{{datname}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Statements per second",
   "description": "Postgres re-parses and re-plans; Prometheus evaluates a decoded matrix. This is the q1 gap in slow motion.",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-monitoring"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 36
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (calls) (rate(pg_stat_statements_calls_total[1m]))",
     "legendFormat": "{{calls}}",
     "refId": "A"
    }
   ]
  }
 ],
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "container",
    "label": "Container",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "bench-monitoring"
    },
    "query": "label_values(container_cpu_usage_seconds_total, container)",
    "includeAll": true,
    "multi": true,
    "refresh": 2
   }
  ]
 }
}