// Cloud variant: local stack PLUS a push to Grafana Cloud.
// Differs from config.local.alloy in exactly one block: the extra receiver.
// Credentials come from the environment, never from this file.
prometheus.scrape "cadvisor" {
  targets = [{
    "__address__"      = "benchctl-cadvisor:8080",
    "__metrics_path__" = "/metrics",
  }]
  forward_to      = [prometheus.relabel.identity.receiver]
  scrape_interval = "10s"
}

prometheus.scrape "sut" {
  targets = [{
    "__address__"      = "benchctl-sut:9090",
    "__metrics_path__" = "/metrics",
    "job"              = "sut",
  }]
  forward_to      = [prometheus.relabel.identity.receiver]
  scrape_interval = "10s"
}

prometheus.relabel "identity" {
  forward_to = [prometheus.remote_write.local.receiver, prometheus.remote_write.cloud.receiver]
  rule {
    source_labels = []
    regex         = ".*"
    replacement   = sys.env("BENCH_RUN_ID")
    target_label  = "run_id"
  }
  rule {
    source_labels = []
    regex         = ".*"
    replacement   = sys.env("BENCH_MODULE")
    target_label  = "module"
  }
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://benchctl-monitoring-prometheus:9090/api/v1/write"
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_RW_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_RW_USER")
      password = sys.env("GRAFANA_CLOUD_RW_PASS")
    }
  }
}
