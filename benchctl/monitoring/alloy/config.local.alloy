// Local-only variant: everything lands in benchctl-monitoring-prometheus.
// The cloud variant adds one remote_write block; nothing else differs.
// Validate: docker run --rm -v "$PWD:/etc/alloy:ro" grafana/alloy:latest \
//   validate /etc/alloy/config.local.alloy

// Per-container CPU and memory, from one cAdvisor endpoint. Scraped exactly
// once: cAdvisor answers for EVERY container on this address, so fanning out
// one target per container makes every container's series claim to be every
// other container's. One scrape, labels already correct.
prometheus.scrape "cadvisor" {
  targets = [{
    "__address__"      = "benchctl-cadvisor:8080",
    "__metrics_path__" = "/metrics",
  }]
  forward_to      = [prometheus.relabel.identity.receiver]
  scrape_interval = "10s"
}

// The system under test, whatever the current module is. Prometheus exposes
// /metrics itself (http requests, TSDB head, WAL); a module that does not
// gets its request counts from its exporter instead — declared in module.yaml,
// scraped here under the same job.
prometheus.scrape "sut" {
  targets = [{
    "__address__"      = "benchctl-sut:9090",
    "__metrics_path__" = "/metrics",
    "job"              = "sut",
  }]
  forward_to      = [prometheus.relabel.identity.receiver]
  scrape_interval = "10s"
}

// Identity: every sample carries which run and which module produced it.
// Without these, every run lands on the same series and history is one flat
// line with no run boundaries.
prometheus.relabel "identity" {
  forward_to = [prometheus.remote_write.local.receiver]
  rule {
    source_labels = []
    regex         = ".*"
    replacement   = sys.env("BENCH_RUN_ID")
    target_label  = "run_id"
  }
  rule {
    source_labels = []
    regex         = ".*"
    replacement   = sys.env("BENCH_MODULE")
    target_label  = "module"
  }
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://benchctl-monitoring-prometheus:9090/api/v1/write"
  }
}
